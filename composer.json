{
    "name": "violetshih/laravel-permission-mongodb",
    "description": "Permission handling for Laravel using MongoDB (Maklad namespace fork)",
    "keywords": [
        "laravel",
        "security",
        "mongodb",
        "permission",
        "acl",
        "maklad",
        "violetshih"
    ],
    "homepage": "https://github.com/violetshih/laravel-permission-mongodb",
    "license": "MIT",
    "authors": [
        {
            "name": "violetshih",
            "email": "swam1991@gmail.com",
            "role": "Maintainer"
        },
        {
            "name": "Mostafa Maklad",
            "email": "dev.mostafa.maklad@gmail.com",
            "homepage": "https://github.com/mostafamaklad",
            "role": "Original package author"
        },
        {
            "name": "Freek Van der Herten",
            "email": "freek@spatie.be",
            "homepage": "https://spatie.be",
            "role": "The original module"
        }
    ],
    "version": "5.0.0",
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "mongodb/laravel-mongodb": "^5.11"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Maklad\\Permission\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maklad\\Permission\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maklad\\Permission\\PermissionServiceProvider"
            ]
        }
    }
}
